{
  "$id": "https://axiom.garden/schema/axiom-garden-world-v1.schema.json",
  "title": "Axiom Garden World Document v1",
  "description": "Strict, versioned format for a bounded abstract square-grid world. Semantic reference checks are performed by @axiom-garden/domain.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "axiom-garden/world"
    },
    "schemaVersion": {
      "allOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^world:[a-z0-9](?:(?:[a-z0-9_-]|\\.(?=[a-z0-9])){0,94}[a-z0-9])?$"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        "tags": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 48,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "title",
        "description",
        "createdAt",
        "updatedAt",
        "tags"
      ],
      "additionalProperties": false
    },
    "grid": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "square"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "origin": {
          "type": "string",
          "const": "top-left"
        },
        "boundary": {
          "type": "string",
          "const": "bounded"
        }
      },
      "required": [
        "kind",
        "width",
        "height",
        "origin",
        "boundary"
      ],
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "properties": {
        "symbols": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^symbol:[a-z0-9](?:(?:[a-z0-9_-]|\\.(?=[a-z0-9])){0,94}[a-z0-9])?$"
              },
              "name": {
                "type": "string",
                "maxLength": 80,
                "pattern": "\\S"
              },
              "shape": {
                "type": "string",
                "enum": [
                  "circle",
                  "square",
                  "triangle",
                  "diamond",
                  "hexagon"
                ]
              },
              "appearance": {
                "type": "object",
                "properties": {
                  "fill": {
                    "type": "string",
                    "enum": [
                      "moss",
                      "clay",
                      "brass",
                      "graphite",
                      "paper",
                      "blue",
                      "amber"
                    ]
                  },
                  "stroke": {
                    "type": "string",
                    "enum": [
                      "moss",
                      "clay",
                      "brass",
                      "graphite",
                      "paper",
                      "blue",
                      "amber"
                    ]
                  },
                  "variant": {
                    "type": "string",
                    "enum": [
                      "solid",
                      "outline",
                      "ring",
                      "dot"
                    ]
                  }
                },
                "required": [
                  "fill",
                  "stroke",
                  "variant"
                ],
                "additionalProperties": false
              },
              "defaultProperties": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z][A-Za-z0-9._-]*$"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 512
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    {
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 512
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  ]
                },
                "maxProperties": 32
              }
            },
            "required": [
              "id",
              "name",
              "shape",
              "appearance",
              "defaultProperties"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "symbols"
      ],
      "additionalProperties": false
    },
    "layers": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^layer:[a-z0-9](?:(?:[a-z0-9_-]|\\.(?=[a-z0-9])){0,94}[a-z0-9])?$"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "pattern": "\\S"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "visible": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "order",
          "visible",
          "locked"
        ],
        "additionalProperties": false
      }
    },
    "cells": {
      "maxItems": 8192,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^cell:[a-z0-9](?:(?:[a-z0-9_-]|\\.(?=[a-z0-9])){0,94}[a-z0-9])?$"
          },
          "layerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^layer:[a-z0-9](?:(?:[a-z0-9_-]|\\.(?=[a-z0-9])){0,94}[a-z0-9])?$"
          },
          "coordinate": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 48,
              "pattern": "\\S"
            }
          },
          "properties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z][A-Za-z0-9._-]*$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 512
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                {
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 512
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              ]
            },
            "maxProperties": 32
          }
        },
        "required": [
          "id",
          "layerId",
          "coordinate",
          "tags",
          "properties"
        ],
        "additionalProperties": false
      }
    },
    "entities": {
      "maxItems": 16384,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^entity:[a-z0-9](?:(?:[a-z0-9_-]|\\.(?=[a-z0-9])){0,94}[a-z0-9])?$"
          },
          "symbolId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^symbol:[a-z0-9](?:(?:[a-z0-9_-]|\\.(?=[a-z0-9])){0,94}[a-z0-9])?$"
          },
          "layerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^layer:[a-z0-9](?:(?:[a-z0-9_-]|\\.(?=[a-z0-9])){0,94}[a-z0-9])?$"
          },
          "coordinate": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "orientation": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 90
              },
              {
                "type": "number",
                "const": 180
              },
              {
                "type": "number",
                "const": 270
              }
            ]
          },
          "properties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z][A-Za-z0-9._-]*$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 512
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                {
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 512
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              ]
            },
            "maxProperties": 32
          }
        },
        "required": [
          "id",
          "symbolId",
          "layerId",
          "coordinate",
          "orientation",
          "properties"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "id",
    "metadata",
    "grid",
    "palette",
    "layers",
    "cells",
    "entities"
  ],
  "additionalProperties": false
}
