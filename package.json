{
  "name": "axiom-garden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A visual laboratory for building, simulating, explaining, and remixing rule-driven puzzle worlds.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @axiom-garden/web dev",
    "dev:worker": "pnpm --filter @axiom-garden/worker dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf .turbo coverage"
  },
  "devDependencies": {
    "@axiom-garden/config-eslint": "workspace:*",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "rimraf": "6.0.1",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
