{
  "name": "axiom-garden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A visual laboratory for building, simulating, explaining, and remixing rule-driven puzzle worlds.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @axiom-garden/web dev",
    "dev:worker": "pnpm --filter @axiom-garden/worker dev",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "turbo run test",
    "test:domain": "pnpm --filter @axiom-garden/domain test",
    "test:engine": "pnpm --filter @axiom-garden/engine test",
    "benchmark:engine": "pnpm --filter @axiom-garden/engine benchmark",
    "test:renderer": "pnpm --filter @axiom-garden/renderer test",
    "benchmark:renderer": "pnpm --filter @axiom-garden/renderer benchmark",
    "test:ui": "pnpm --filter @axiom-garden/ui test",
    "test:e2e": "node scripts/run-browser-tests.mjs e2e",
    "test:a11y": "node scripts/run-browser-tests.mjs a11y",
    "test:smoke": "pnpm build && node scripts/run-browser-tests.mjs smoke",
    "schema:generate": "pnpm --filter @axiom-garden/domain schema:generate",
    "schema:check": "pnpm --filter @axiom-garden/domain schema:check",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf .turbo coverage"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@axiom-garden/config-eslint": "workspace:*",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "rimraf": "6.0.1",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
